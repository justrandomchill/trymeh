## 2. Calculator forma poloneza

### Enunt
Calculator care evalueaza expresii infixate (cu paranteze) prin transformare in **forma postfixata** (algoritmul Shunting-yard cu stiva de operatori + dictionar de prioritati), apoi evalueaza forma postfixata cu stiva de operanzi.

### Diagrama
```mermaid
classDiagram
    class Form1 {
        -stivaOperatori: Stack~char~
        -stivaOperanzi: Stack~int~
        -expresie: string
        -expresiePostfixata: string
        -prioritatiOperatori: Dictionary
        +callbackSimbol()
        +callbackEgal()
        +callbackBackspace()
    }
```

### Cod (`Form1.cs`)
```csharp
using System;
using System.Collections.Generic;
using System.Windows.Forms;

namespace Subiect_2
{
    public partial class Form1 : Form
    {
        private Stack<char> stivaOperatori;
        private Stack<int> stivaOperanzi;
        private string expresie;
        private string expresiePostfixata;
        private Dictionary<char, int> prioritatiOperatori;
        private int rezultat;

        public Form1()
        {
            expresie = null; expresiePostfixata = null; rezultat = 0;
            prioritatiOperatori = new Dictionary<char, int>();
            prioritatiOperatori.Add('#', -1);
            prioritatiOperatori.Add('(', 0);
            prioritatiOperatori.Add('+', 1);
            prioritatiOperatori.Add('-', 1);
            prioritatiOperatori.Add('*', 2);
            prioritatiOperatori.Add('/', 2);
            stivaOperatori = new Stack<char>();
            stivaOperanzi = new Stack<int>();
            InitializeComponent();
        }

        private bool esteOperator(char s) => s == '+' || s == '-' || s == '*' || s == '/';

        private void callbackEgal(object sender, EventArgs e)
        {
            afisaj.Clear();
            if (expresie == null) return;

            stivaOperatori.Push('#');
            for (int i = 0; i < expresie.Length; i++)
            {
                char simbol = expresie[i];
                if (Char.IsDigit(simbol)) expresiePostfixata += simbol;
                else if (esteOperator(simbol))
                {
                    while (stivaOperatori.Count != 0 && prioritatiOperatori[simbol] <= prioritatiOperatori[stivaOperatori.Peek()])
                        expresiePostfixata += stivaOperatori.Pop();
                    stivaOperatori.Push(simbol);
                }
                else if (simbol == '(') stivaOperatori.Push(simbol);
                else if (simbol == ')')
                {
                    while (stivaOperatori.Count != 1 && stivaOperatori.Peek() != '(')
                        expresiePostfixata += stivaOperatori.Pop();
                    if (stivaOperatori.Count == 1)
                    {
                        afisaj.Clear(); afisaj.AppendText("Eroare!");
                        stivaOperatori.Clear(); expresie = null; return;
                    }
                    stivaOperatori.Pop();
                }
                else
                {
                    afisaj.Clear(); afisaj.AppendText("Eroare!");
                    stivaOperatori.Clear(); expresie = null; return;
                }
            }
            while (stivaOperatori.Count != 1)
            {
                if (stivaOperatori.Peek() == '(')
                {
                    afisaj.Clear(); afisaj.AppendText("Eroare!");
                    stivaOperatori.Clear(); expresie = null; return;
                }
                expresiePostfixata += stivaOperatori.Pop();
            }
            stivaOperatori.Clear();

            // Evaluare postfixata
            int op1, op2;
            for (int i = 0; i < expresiePostfixata.Length; i++)
            {
                char simbol = expresiePostfixata[i];
                if (Char.IsDigit(simbol)) stivaOperanzi.Push(simbol - '0');
                else if (esteOperator(simbol))
                {
                    op2 = stivaOperanzi.Pop();
                    op1 = stivaOperanzi.Pop();
                    switch (simbol)
                    {
                        case '+': rezultat = op1 + op2; break;
                        case '-': rezultat = op1 - op2; break;
                        case '*': rezultat = op1 * op2; break;
                        case '/': rezultat = op1 / op2; break;
                    }
                    stivaOperanzi.Push(rezultat);
                }
            }
            if (stivaOperanzi.Count == 1)
            {
                expresie = stivaOperanzi.Pop().ToString();
                afisaj.AppendText(expresie);
            }
            else { afisaj.AppendText("Eroare la evaluare."); expresie = null; }
            expresiePostfixata = null;
            stivaOperanzi.Clear();
        }

        private void callbackSimbol(object sender, EventArgs e)
        {
            if (expresie == null) afisaj.Clear();
            expresie += ((Button)sender).Text;
            afisaj.AppendText(((Button)sender).Text);
        }

        private void callbackBackspace(object sender, EventArgs e)
        {
            if (expresie != null)
            {
                expresie = expresie.Remove(expresie.Length - 1);
                afisaj.Clear(); afisaj.AppendText(expresie);
                if (expresie.Length == 0) expresie = null;
            }
        }

        private void callbackStergere(object sender, EventArgs e)
        {
            afisaj.Clear(); expresie = null;
        }
    }
}
```


```

### Cod (`Program.cs`)
```csharp
using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Threading;

namespace Subiect_14
{
    class Program
    {
        private static int n;
        private static List<StreamReader> readereFisiere;
        private static StreamWriter writerIesire;
        private static Object writeLock = new Object();
        private static List<Thread> threaduri;

        static void Main(string[] args)
        {
            Console.Write("Nr fisiere intrare: "); n = Int32.Parse(Console.ReadLine());
            readereFisiere = new List<StreamReader>();
            for (int i = 0; i < n; i++)
            {
                Console.Write("Fisier {0}: ", i + 1);
                string nf = Console.ReadLine();
                try { readereFisiere.Add(new StreamReader(nf)); }
                catch { Console.WriteLine("Eroare {0}", nf); return; }
            }
            Console.Write("Fisier iesire: ");
            writerIesire = new StreamWriter(Console.ReadLine());

            threaduri = new List<Thread>();
            for (int i = 0; i < n; i++)
            {
                Thread t = new Thread(new ParameterizedThreadStart(procesare));
                threaduri.Add(t);
                t.Start(readereFisiere.ElementAt(i));
            }
            foreach (Thread t in threaduri) t.Join();
            writerIesire.Close();
            Console.Read();
        }

        private static void procesare(object obj)
        {
            StreamReader sr = (StreamReader)obj;
            string linie;
            while ((linie = sr.ReadLine()) != null)
            {
                lock (writeLock) { writerIesire.WriteLine(linie); }
            }
            sr.Close();
        }
    }
}

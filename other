### Cod StudentLibrary (`StudentService.cs`)
```csharp
using System;
using System.Collections.Generic;

namespace StudentLibrary
{
    public class StudentService : MarshalByRefObject
    {
        private List<string> materii;
        private List<Grupa> grupeStudenti;
        private List<Nota> note;

        public StudentService() { materii = null; grupeStudenti = null; note = null; }

        private class Nota
        {
            public double nota; public int idStudent; public int idMaterie;
            public Nota(double n, int ids, int idm) { nota = n; idStudent = ids; idMaterie = idm; }
            public bool isEqual(Nota n) => n.nota == nota && n.idStudent == idStudent && n.idMaterie == idMaterie;
        }

        private class Grupa
        {
            public string grupa;
            public List<string> studenti;
            public Grupa(string g) { grupa = g; studenti = new List<string>(); }
            public void adauga(string s) { if (!studenti.Contains(s)) studenti.Add(s); }
        }

        [Serializable]
        public class StudentNota
        {
            public string numeStudent; public double nota;
            public StudentNota() { numeStudent = ""; nota = 0; }
            public StudentNota(string ns, double n) { numeStudent = ns; nota = n; }
        }

        public int adaugaMaterie(string n)
        {
            if (materii == null) materii = new List<string>();
            if (materii.Contains(n)) return materii.IndexOf(n);
            materii.Add(n);
            return materii.IndexOf(n);
        }

        public int adaugaStudent(string n, string g)
        {
            if (grupeStudenti == null) grupeStudenti = new List<Grupa>();
            foreach (Grupa gr in grupeStudenti)
                if (gr.grupa == g) { gr.adauga(n); return gr.studenti.IndexOf(n); }
            Grupa noua = new Grupa(g); noua.adauga(n);
            grupeStudenti.Add(noua);
            return noua.studenti.IndexOf(n);
        }

        public bool adaugaNota(double nota, int idS, int idM)
        {
            if (note == null) note = new List<Nota>();
            Nota n = new Nota(nota, idS, idM);
            foreach (Nota e in note) if (e.isEqual(n)) return false;
            note.Add(n); return true;
        }

        public StudentNota[] returneazaNote(int idMaterie)
        {
            if (note == null || materii == null) return null;
            List<StudentNota> lista = new List<StudentNota>();
            foreach (Nota n in note)
                if (n.idMaterie == idMaterie)
                    lista.Add(new StudentNota(materii[idMaterie], n.nota));
            return lista.ToArray();
        }

        public string[] returneazaStudenti(string g)
        {
            if (grupeStudenti == null) return null;
            foreach (Grupa gr in grupeStudenti)
                if (gr.grupa == g) return gr.studenti.ToArray();
            return null;
        }
    }
}

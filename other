```

### Cod WebService (`NotareStudenti.asmx.cs`)
```csharp
using System;
using System.Collections.Generic;
using System.Linq;
using System.Web.Services;

namespace StudentServices
{
    public class NotareStudenti : System.Web.Services.WebService
    {
        static int idMaterie = 0;
        static int idStudent = 0;
        static List<Materie> listaMaterii = new List<Materie>();
        static List<Student> listaStudenti = new List<Student>();
        static List<Note> listaNote = new List<Note>();

        [WebMethod]
        public void clearLista()
        {
            listaMaterii.Clear(); listaStudenti.Clear(); listaNote.Clear();
            idMaterie = 0; idStudent = 0;
        }

        [WebMethod]
        public void adaugaMaterie(string numeMaterie)
        {
            listaMaterii.Add(new Materie(idMaterie, numeMaterie));
            idMaterie++;
        }

        [WebMethod]
        public void adaugaStudent(string numeStudent, string grupa)
        {
            listaStudenti.Add(new Student(idStudent, numeStudent, grupa));
            idStudent++;
        }

        [WebMethod]
        public int adaugaNota(string numeStudent, string materie, byte nota)
        {
            int index1 = -1, index2 = -1;
            for (int i = 0; i < listaStudenti.Count; i++)
                if (listaStudenti[i].numeStudent.ToUpper() == numeStudent.ToUpper())
                    index1 = i;
            for (int i = 0; i < listaMaterii.Count; i++)
                if (listaMaterii[i].numeMaterie.ToUpper() == materie.ToUpper())
                    index2 = i;
            if (index1 >= 0 && index2 >= 0 && nota < 11)
                listaNote.Add(new Note(index1, index2, nota));
            return listaNote.Count;
        }

        [WebMethod]
        public string returneazaStudenti(string grupa)
        {
            string sr = "";
            foreach (Student s in listaStudenti)
                if (s.grupaStudent == grupa) sr += s.numeStudent + ";";
            return sr;
        }

        [WebMethod]
        public string returneazaNote(string materie)
        {
            string sr = "";
            int idM = -1;
            for (int i = 0; i < listaMaterii.Count; i++)
                if (listaMaterii[i].numeMaterie.ToUpper() == materie.ToUpper())

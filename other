## 3. Client-Server TCP sincron

### Enunt
Server TCP care primeste mesaje de la mai multi clienti (cate un thread per client), si **trimite mesajele inapoi la TOTI clientii** conectati (broadcast). Foloseste `Socket.Send()` si `Socket.Receive()` sincron.

### Diagrama
```mermaid
graph TB
    C1[Client 1] -->|Send| S[Server port 11000]
    C2[Client 2] -->|Send| S
    C3[Client 3] -->|Send| S
    S -->|broadcast Send| C1
    S -->|broadcast Send| C2
    S -->|broadcast Send| C3
    S -.->|thread per client| T[procesareClient]
```

### Cod Server (`SocketServerSync.cs`)
```csharp
using System;
using System.Collections.Generic;
using System.Net;
using System.Net.Sockets;
using System.Text;
using System.Threading;

namespace Server
{
    class SocketServerSync
    {
        private static List<Socket> clienti;
        private static List<Thread> threaduri;

        public static void pornireServer()
        {
            IPHostEntry ipHostInfo = Dns.Resolve(Dns.GetHostName());
            IPAddress ipAddress = ipHostInfo.AddressList[0];
            IPEndPoint localEndPoint = new IPEndPoint(ipAddress, 11000);
            Socket listener = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);
            clienti = new List<Socket>();
            threaduri = new List<Thread>();
            try
            {
                listener.Bind(localEndPoint);
                listener.Listen(10);
                Console.WriteLine("Se asteapta o conexiune...");
                while (true)
                {
                    Socket handler = listener.Accept();
                    Console.WriteLine("Conectat: {0}.", handler.RemoteEndPoint);
                    clienti.Add(handler);
                    Thread t = new Thread(new ParameterizedThreadStart(procesareClient));
                    threaduri.Add(t);
                    t.Start(handler);
                }
            }
            catch (Exception e) { Console.WriteLine(e.ToString()); }
        }

        private static void procesareClient(object obj)
        {
            Socket handler = (Socket)obj;
            byte[] bytes = new byte[1024];
            string data = null;
            while (true)
            {
                int bytesRec = handler.Receive(bytes);
                data = Encoding.ASCII.GetString(bytes, 0, bytesRec);
                if (data.IndexOf("EXIT") > -1)
                {
                    Console.WriteLine("Deconectat: {0}.", handler.RemoteEndPoint);
                    handler.Shutdown(SocketShutdown.Both); handler.Close();
                    clienti.Remove(handler);
                    threaduri.Remove(Thread.CurrentThread);
                    break;
                }
                Console.WriteLine("[CLIENT {0}] <<< {1}", handler.RemoteEndPoint, data);
                byte[] msg = Encoding.ASCII.GetBytes(data);
                foreach (Socket s in clienti) s.Send(msg);
            }
        }

        static void Main(string[] args) => pornireServer();
    }
}
```

### Cod Client (`SocketClientSync.cs`)
```csharp
using System;
using System.Net;
using System.Net.Sockets;
using System.Text;
using System.Threading;

namespace Client
{
    class SocketClientSync
    {
        public static void pornireClient()
        {
            IPHostEntry ipHostInfo = Dns.Resolve(Dns.GetHostName());
            IPAddress ipAddress = ipHostInfo.AddressList[0];
            IPEndPoint remoteEP = new IPEndPoint(ipAddress, 11000);
            Socket sender = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);
            sender.Connect(remoteEP);
            Console.WriteLine("Conectat la {0}. Scrieti EXIT pentru iesire.", sender.RemoteEndPoint);

            Thread tt = new Thread(new ParameterizedThreadStart(trimitereMesaj));
            Thread tp = new Thread(new ParameterizedThreadStart(primireRaspuns));
            tt.Start(sender); tp.Start(sender);
            tt.Join(); tp.Join();
            sender.Shutdown(SocketShutdown.Both); sender.Close();
        }

        private static void primireRaspuns(object obj)
        {
            Socket s = (Socket)obj;
            byte[] bytes = new byte[1024];
            while (true)
            {
                int b = s.Receive(bytes);
                Console.WriteLine("[SERVER] <<< {0}", Encoding.ASCII.GetString(bytes, 0, b));
            }
        }

        private static void trimitereMesaj(object obj)
        {
            Socket s = (Socket)obj;
            string mesaj;
            do
            {
                mesaj = Console.ReadLine();
                s.Send(Encoding.ASCII.GetBytes(mesaj));
            } while (mesaj != "EXIT");
        }

        static void Main(string[] args) => pornireClient();
    }
}
```


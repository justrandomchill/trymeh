        -operand1: string
        -operand2: string
        -operatie: char
        -operatorApasat: bool
        -egalApasat: bool
        +callbackOperand()
        +callbackOperator()
        +callbackLogaritm()
        +callbackVirgula()
        +callbackEgal()
        +callbackStergere()
    }
```

### Cod (`Form1.cs`)
```csharp
using System;
using System.Windows.Forms;

namespace Subiect_1
{
    public partial class Form1 : Form
    {
        private string operand1, operand2;
        private char operatie;
        private bool operatorApasat;
        private bool egalApasat;

        public Form1()
        {
            InitializeComponent();
            operand1 = operand2 = null;
            operatie = '\0';
            operatorApasat = false;
            egalApasat = false;
        }

        private void callbackOperand(object sender, EventArgs e)
        {
            Button butonApasat = (Button)sender;
            if (operand1 == null || egalApasat == true)
            {
                afisaj.Clear(); operand1 = null; egalApasat = false;
            }
            if (operatorApasat) operand2 += butonApasat.Text;
            else operand1 += butonApasat.Text;
            afisaj.AppendText(butonApasat.Text);
        }

        private void callbackOperator(object sender, EventArgs e)
        {
            Button op = (Button)sender;
            operatie = op.Text[0];
            afisaj.Clear();
            operatorApasat = true;
            egalApasat = false;
        }

        private void callbackLogaritm(object sender, EventArgs e)
        {
            if (operand1 != null)
            {
                double arg = Double.Parse(operand1);
                if (arg <= 0)
                {
                    afisaj.AppendText("Eroare! Doar numere strict pozitive.");
                    operand1 = null; operand2 = null; operatie = '\0';
                    operatorApasat = false; return;
                }
                operand1 = Math.Log(arg).ToString();
                afisaj.Clear(); afisaj.AppendText(operand1);
                operatie = '\0'; operatorApasat = false;
            }
        }

        private void callbackVirgula(object sender, EventArgs e)
        {
            if (operand1 == null || egalApasat)
            {
                afisaj.Clear(); operand1 = null; egalApasat = false;
            }
            if (operand1 != null && operand1.IndexOf(',') == -1)
            {
                if (operatorApasat) operand2 += ",";
                else operand1 += ",";
                afisaj.AppendText(",");
            }
        }

        private void callbackEgal(object sender, EventArgs e)
        {
            if (operand1 != null && operand2 != null)
            {
                double rezultat = 0;
                switch (operatie)
                {
                    case '+': rezultat = Double.Parse(operand1) + Double.Parse(operand2); break;
                    case '-': rezultat = Double.Parse(operand1) - Double.Parse(operand2); break;
                    case '*': rezultat = Double.Parse(operand1) * Double.Parse(operand2); break;
                    case '/':
                        if (Double.Parse(operand2) == 0)
                        {
                            afisaj.Clear(); afisaj.AppendText("Eroare! Impartire la 0!");
                            operand1 = null; operand2 = null; operatie = '\0';
                            operatorApasat = false; egalApasat = false; return;
                        }
                        rezultat = Double.Parse(operand1) / Double.Parse(operand2); break;
                    case '^': rezultat = Math.Pow(Double.Parse(operand1), Double.Parse(operand2)); break;
                }
                afisaj.Clear();
                operand1 = rezultat.ToString();
                operand2 = null; operatie = '\0';
                afisaj.AppendText(operand1);
                operatorApasat = false; egalApasat = true;
            }
        }

        private void callbackStergere(object sender, EventArgs e)
        {
            afisaj.Clear();
            operand1 = null; operand2 = null;
            operatie = '\0'; operatorApasat = false;
        }
    }
}
```


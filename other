## 17. TreeView -> XML

### Enunt
Aplicatie WinForms care:
1. Deschide un XML si il afiseaza ca arbore in `TreeView` (`CheckBoxes = true`).
2. Permite bifarea/debifarea nodurilor (la bifarea unui parinte se bifeaza si copiii, etc.).
3. Salveaza nodurile **bifate** intr-un nou XML.

### Diagrama
```mermaid
graph LR
    XML1[XML input] -->|XmlDocument.Load| TV[TreeView]
    TV -->|user bifeaza| TV
    TV -->|XmlTextWriter| XML2[XML output<br/>doar bifate]
```

### Cod (`Form1.cs`)
```csharp
using System;
using System.Text;
using System.Windows.Forms;
using System.Xml;

namespace Subiect_17
{
    public partial class Form1 : Form
    {
        XmlDocument xml = null;
        string fisierXML = null;

        public Form1() { InitializeComponent(); }

        private void butonDeschideXML_Click(object sender, EventArgs e)
        {
            OpenFileDialog ofd = new OpenFileDialog();
            ofd.Filter = "XML (*.xml)|*.xml";
            if (ofd.ShowDialog() != DialogResult.OK) return;
            fisierXML = ofd.FileName;
            xml = new XmlDocument();
            xml.Load(fisierXML);
            treeView.Nodes.Clear();
            treeView.Nodes.Add(new TreeNode(xml.DocumentElement.Name));
            adaugaNoduri(xml.DocumentElement, treeView.Nodes[0]);
            treeView.ExpandAll();
        }

        private void adaugaNoduri(XmlNode nodXML, TreeNode nodTV)
        {
            if (nodXML.HasChildNodes)
            {
                for (int i = 0; i < nodXML.ChildNodes.Count; i++)
                {
                    nodTV.Nodes.Add(new TreeNode(nodXML.ChildNodes[i].Name));
                    adaugaNoduri(nodXML.ChildNodes[i], nodTV.Nodes[i]);
                }
            }
            else nodTV.Text = nodXML.OuterXml.Trim();
        }

        private void OnAfterCheck(object sender, TreeViewEventArgs e)
        {
            if (e.Action == TreeViewAction.Unknown) return;
            bifeazaFii(e.Node);
            if (e.Node.Checked)
            {
                TreeNode n = e.Node;
                while (n.Parent != null) { n.Parent.Checked = true; n = n.Parent; }
            }
        }

        private void bifeazaFii(TreeNode parinte)
        {
            if (parinte == null) return;
            foreach (TreeNode fiu in parinte.Nodes)
            {
                fiu.Checked = parinte.Checked;
                bifeazaFii(fiu);
            }
        }

        private void butonSalvareXML_Click(object sender, EventArgs e)
        {
            SaveFileDialog sfd = new SaveFileDialog();
            sfd.ShowDialog();
            XmlTextWriter w = new XmlTextWriter(sfd.FileName, Encoding.ASCII);
            w.Formatting = Formatting.Indented;
            w.WriteStartDocument();
            w.WriteStartElement("treeview");
            saveNodes(treeView.Nodes, w);
            w.WriteEndElement();
            w.Close();
            MessageBox.Show("Salvat!");
        }

        private void saveNodes(TreeNodeCollection lista, XmlTextWriter w)
        {
            foreach (TreeNode nod in lista)
                if (nod.Checked)
                {
                    w.WriteStartElement("node");
                    w.WriteAttributeString("text", nod.Text);
                    if (nod.Nodes.Count > 0) saveNodes(nod.Nodes, w);
                    w.WriteEndElement();
                }
        }
    }
}
```


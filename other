## 13. MergeSort recursiv cu Threads

### Enunt
Implementare MergeSort cu **thread-uri pentru fiecare apel recursiv**. Fiecare partitie pleaca cu 2 thread-uri noi pentru cele 2 jumatati, apoi interclaseaza.

### Diagrama
```mermaid
graph TB
    M[mergeSort 0..n-1] --> L[Thread stanga 0..mij]
    M --> R[Thread dreapta mij+1..n-1]
    L --> LL[Thread stanga stanga]
    L --> LR[Thread stanga dreapta]
    R --> RL[Thread dreapta stanga]
    R --> RR[Thread dreapta dreapta]
    LL & LR & RL & RR --> I[interclasare]
```

### Cod (`Program.cs`)
```csharp
using System;
using System.Threading;

namespace Subiect_13
{
    class Program
    {
        private static int n;
        private static double[] vector;

        static void Main(string[] args)
        {
            Console.Write("n (max 128): "); n = Int32.Parse(Console.ReadLine());
            if (n > 128) { Console.WriteLine("n prea mare."); Console.Read(); return; }
            vector = new double[n];
            for (int i = 0; i < n; i++)
            {
                Console.Write("Numar {0}: ", i + 1);
                vector[i] = Double.Parse(Console.ReadLine());
            }

            mergeSort(new IntervalSortare(0, n - 1));

            foreach (double e in vector) Console.Write("{0}; ", e);
            Console.Read();
        }

        private static void mergeSort(object obj)
        {
            IntervalSortare isort = (IntervalSortare)obj;
            int st = isort.St, dr = isort.Dr;
            if (st < dr)
            {
                int mij = (st + dr) / 2;
                Thread t1 = new Thread(new ParameterizedThreadStart(mergeSort));
                Thread t2 = new Thread(new ParameterizedThreadStart(mergeSort));
                t1.Start(new IntervalSortare(st, mij));
                t2.Start(new IntervalSortare(mij + 1, dr));
                t1.Join(); t2.Join();
                interclasare(st, mij, dr);
            }
        }

        private class IntervalSortare
        {
            public int St, Dr;
            public IntervalSortare(int s, int d) { St = s; Dr = d; }
        }

        private static void interclasare(int st, int mij, int dr)
        {
            int n1 = mij - st + 1, n2 = dr - mij;
            double[] t1 = new double[n1], t2 = new double[n2];
            for (int i = 0; i < n1; i++) t1[i] = vector[st + i];
            for (int j = 0; j < n2; j++) t2[j] = vector[mij + 1 + j];

            int x = 0, y = 0, k = st;
            while (x < n1 && y < n2)
            {
                if (t1[x] <= t2[y]) vector[k++] = t1[x++];
                else vector[k++] = t2[y++];
            }
            while (x < n1) vector[k++] = t1[x++];
            while (y < n2) vector[k++] = t2[y++];
        }
    }
}

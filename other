    Cb -->|DllImport| K32[kernel32.dll<br/>GetSystemTime]
    K32 --> Sys[SYSTEMTIME struct]
    Sys --> Label[Label ceas]
```

### Cod (`Form1.cs`)
```csharp
using System;
using System.Runtime.InteropServices;
using System.Windows.Forms;

namespace Subiect_16
{
    public partial class Form1 : Form
    {
        [DllImport("kernel32.dll")]
        private extern static void GetSystemTime(ref SYSTEMTIME lpSystemTime);

        private struct SYSTEMTIME
        {
            public ushort wYear, wMonth, wDayOfWeek, wDay;
            public ushort wHour, wMinute, wSecond, wMilliseconds;
        }

        private static SYSTEMTIME timp = new SYSTEMTIME();

        public Form1()
        {
            InitializeComponent();
            Timer t = new Timer();
            t.Interval = 1000;
            t.Tick += new EventHandler(afiseazaOra);
            t.Start();
        }

        public void afiseazaOra(object obj, EventArgs args)
        {
            GetSystemTime(ref timp);
            DateTime d = new DateTime(timp.wYear, timp.wMonth, timp.wDay,
                timp.wHour, timp.wMinute, timp.wSecond);
            d = d.ToLocalTime();
            ceas.Text = d.ToString();
        }
    }
}

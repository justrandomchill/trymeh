## 20. App.config -> XML

### Enunt
Aplicatie WinForms care:
1. Citeste valori dintr-un `App.config` (sectiunea `<appSettings>`) folosind `ConfigurationManager.AppSettings`.
2. Suma valorilor afisata pe form.
3. Salveaza rezultatul intr-un XML cu `XmlTextWriter`.

### App.config
```xml
<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="a" value="10"/>
    <add key="b" value="20"/>
    <add key="c" value="5"/>
  </appSettings>
</configuration>
```

### Cod (`Form1.cs`)
```csharp
using System;
using System.Configuration;
using System.Text;
using System.Windows.Forms;
using System.Xml;

namespace Subiect_20
{
    public partial class Form1 : Form
    {
        int rezultatCalcul = 0;

        public Form1() { InitializeComponent(); }

        private void butonCalculeaza_Click(object sender, EventArgs e)
        {
            foreach (string key in ConfigurationManager.AppSettings)
                rezultatCalcul += Int32.Parse(ConfigurationManager.AppSettings[key]);
            rezultat.Text = "Rezultat: " + rezultatCalcul;
            MessageBox.Show("Rezultat: " + rezultatCalcul);
        }

        private void butonSalvare_Click(object sender, EventArgs e)
        {
            XmlTextWriter w = new XmlTextWriter("rezultat.xml", Encoding.ASCII);
            w.Formatting = Formatting.Indented;
            w.WriteStartDocument();
            w.WriteStartElement("rezultate");
            w.WriteElementString("rezultat", rezultatCalcul.ToString());
            w.WriteEndElement();
            w.WriteEndDocument();
            w.Close();
            MessageBox.Show("Salvat in rezultat.xml.");
        }
    }
}

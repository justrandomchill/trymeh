## 11. Suma 0..n cu 4 threaduri

### Enunt
Citeste `n` (multiplu de 4). Imparte intervalul `[0, n]` in 4 subintervale egale si fiecare thread sumeaza pe subintervalul lui. Thread-ul master aduna rezultatele partiale.

### Diagrama
```mermaid
graph LR
    Master[Main thread] --> I1[Thread 1: 0..n/4]
    Master --> I2[Thread 2: n/4+1..n/2]
    Master --> I3[Thread 3: n/2+1..3n/4]
    Master --> I4[Thread 4: 3n/4+1..n]
    I1 --> Sum[Master suma finala]
    I2 --> Sum
    I3 --> Sum
    I4 --> Sum
```

### Cod (`Program.cs`)
```csharp
using System;
using System.Threading;

namespace Subiect_11
{
    class Program
    {
        private static int n = 0;
        private static int rezultat = 0;

        static void Main(string[] args)
        {
            Console.Write("Introduceti n (multiplu de 4): ");
            try { n = Int32.Parse(Console.ReadLine()); }
            catch { Console.WriteLine("Numar invalid."); Console.Read(); return; }
            if (n % 4 != 0) { Console.WriteLine("Nu e multiplu de 4."); Console.Read(); return; }

            IntervalSumare i1 = new IntervalSumare(0, n / 4);
            IntervalSumare i2 = new IntervalSumare(n / 4 + 1, n / 2);
            IntervalSumare i3 = new IntervalSumare(n / 2 + 1, 3 * n / 4);
            IntervalSumare i4 = new IntervalSumare(3 * n / 4 + 1, n);

            Thread t1 = new Thread(new ParameterizedThreadStart(aduna));
            Thread t2 = new Thread(new ParameterizedThreadStart(aduna));
            Thread t3 = new Thread(new ParameterizedThreadStart(aduna));
            Thread t4 = new Thread(new ParameterizedThreadStart(aduna));
            t1.Start(i1); t2.Start(i2); t3.Start(i3); t4.Start(i4);
            t1.Join(); t2.Join(); t3.Join(); t4.Join();

            rezultat += i1.Rezultat + i2.Rezultat + i3.Rezultat + i4.Rezultat;
            Console.WriteLine("Suma de la 0 la {0}: {1}", n, rezultat);
            Console.Read();
        }

        private static void aduna(object obj)
        {
            IntervalSumare isum = (IntervalSumare)obj;
            for (int i = isum.Inceput; i <= isum.Sfarsit; i++)
                isum.Rezultat += i;
        }

        private class IntervalSumare
        {
            public int Inceput, Sfarsit, Rezultat = 0;
            public IntervalSumare(int i, int j) { Inceput = i; Sfarsit = j; }
        }
    }
}

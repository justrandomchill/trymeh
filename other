## 4. Client-Server TCP asincron

### Enunt
Aceeasi aplicatie ca subiectul 3, dar **asincron** cu `BeginReceive` + callback. In loc de threaduri blocate pe `Receive()`, se foloseste `IAsyncResult` cu `EndReceive`.

### Diagrama
```mermaid
graph LR
    C[Client] -->|BeginReceive| S[Server port 11000]
    S -->|procesarePrimire callback| Cb[AsyncCallback]
    Cb -->|BeginReceive recursiv| S
```

### Cod Server (`SocketServerAsync.cs`)
```csharp
using System;
using System.Collections.Generic;
using System.Net;
using System.Net.Sockets;
using System.Text;
using System.Threading;

namespace Server
{
    class SocketServerAsync
    {
        private static List<Socket> clienti;
        private static List<Thread> threaduri;

        public static void pornireServer()
        {
            IPHostEntry ipHostInfo = Dns.Resolve(Dns.GetHostName());
            IPAddress ipAddress = ipHostInfo.AddressList[0];
            IPEndPoint localEP = new IPEndPoint(ipAddress, 11000);
            Socket listener = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);
            clienti = new List<Socket>();
            threaduri = new List<Thread>();
            listener.Bind(localEP);
            listener.Listen(10);
            while (true)
            {
                Socket handler = listener.Accept();
                clienti.Add(handler);
                Thread t = new Thread(new ParameterizedThreadStart(procesareClient));
                threaduri.Add(t);
                t.Start(handler);
            }
        }

        private static void procesareClient(object obj)
        {
            Socket handler = (Socket)obj;
            byte[] bytes = new byte[1024];
            handler.BeginReceive(bytes, 0, bytes.Length, 0,
                new AsyncCallback(procesarePrimire), new ParametriPrimire(handler, bytes));
        }

        private class ParametriPrimire
        {
            public Socket handler; public byte[] buffer;
            public ParametriPrimire(Socket s, byte[] b) { handler = s; buffer = b; }
        }

        private static void procesarePrimire(IAsyncResult ar)
        {
            ParametriPrimire p = (ParametriPrimire)ar.AsyncState;
            int bytesRec = p.handler.EndReceive(ar);
            if (bytesRec > 0)
            {
                string data = Encoding.ASCII.GetString(p.buffer, 0, bytesRec);
                if (data.IndexOf("EXIT") > -1)
                {
                    p.handler.Shutdown(SocketShutdown.Both); p.handler.Close();
                    clienti.Remove(p.handler);
                    threaduri.Remove(Thread.CurrentThread);
                    return;
                }
                Console.WriteLine("[CLIENT] <<< {0}", data);
                p.handler.Send(Encoding.ASCII.GetBytes(data));
            }
            p.handler.BeginReceive(p.buffer, 0, p.buffer.Length, 0,
                new AsyncCallback(procesarePrimire), new ParametriPrimire(p.handler, p.buffer));
        }

        static void Main(string[] args) => pornireServer();
    }
}
```

### Cod Client (`SocketClientAsync.cs`)
Similar cu subiectul 3 client, dar foloseste `sender.BeginReceive(...)` cu callback `procesarePrimire`:
```csharp
sender.BeginReceive(bytes, 0, bytes.Length, 0, procesarePrimire, new ParametriPrimire(sender, bytes));
```


## 18. Structura directoare -> XML

### Enunt
Aplicatie WinForms cu `FolderBrowserDialog`. Selecteaza un director si scrie **recursiv** structura de foldere si fisiere intr-un XML cu numele folderului radacina + `.xml`.

### Cod (`Form1.cs`)
```csharp
using System;
using System.IO;
using System.Text;
using System.Windows.Forms;
using System.Xml;

namespace Subiect_18
{
    public partial class Form1 : Form
    {
        DirectoryInfo folder = null;

        public Form1() { InitializeComponent(); }

        private void butonDeschidereDirector_Click(object sender, EventArgs e)
        {
            FolderBrowserDialog fbd = new FolderBrowserDialog();
            if (fbd.ShowDialog() == DialogResult.OK)
            {
                folder = new DirectoryInfo(fbd.SelectedPath);
                folderDeschis.Text = folder.Name;
            }
        }

        private void butonScriereXML_Click(object sender, EventArgs e)
        {
            if (folder == null) return;
            XmlTextWriter w = new XmlTextWriter(folder.Name + ".xml", Encoding.ASCII);
            w.Formatting = Formatting.Indented;
            w.WriteStartDocument();
            salvareFoldere(folder, w);
            w.WriteEndDocument();
            w.Close();
            MessageBox.Show("Salvat in " + folder.Name + ".xml");
        }

        private void salvareFoldere(DirectoryInfo dir, XmlTextWriter w)
        {
            if (dir == null) return;
            w.WriteStartElement("folder");
            w.WriteAttributeString("nume", dir.Name);
            try
            {
                foreach (DirectoryInfo d in dir.GetDirectories())
                    salvareFoldere(d, w);
                foreach (FileInfo f in dir.GetFiles())
                {
                    w.WriteStartElement("fisier");
                    w.WriteAttributeString("nume", f.Name);
                    w.WriteEndElement();
                }
            }
            catch { /* permisiuni */ }
            finally { w.WriteEndElement(); }
        }
    }
}
```

